# .gitignore pour projet Unity (basé sur le modèle officiel GitHub "Unity")
# À placer à la RACINE du projet (à côté des dossiers Assets, Packages, ProjectSettings)

# Dossiers générés automatiquement par Unity (recréés à l'ouverture du projet)
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Sauvegardes automatiques de Blender
*.blend1
*.blend1.meta

# Captures mémoire et enregistrements (lourds)
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Plugin Rider généré automatiquement
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Caches Visual Studio / Gradle (build Android)
.vs/
.gradle/

# Fichiers de solution générés par Unity
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Rapports de crash et fichiers Mono
sysinfo.txt
mono_crash.*

# Builds (APK pour le Quest, etc.)
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Divers
crashlytics-build.properties
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*